{% extends '@theme/layout.twig' %}
{% set active = 'work' %}

{% block title %}Work — Anyo at Disenyo{% endblock %}
{% set meta_description = 'Selected architectural renders and projects by Anyo at Disenyo, a Batangas City practice designing climate-smart Filipino homes.' %}

{% block head %}
<style>
    .proj { position: relative; padding-top: clamp(2.5rem,5vw,4rem); }
    .proj__num {
        font-family: var(--display); font-weight: 700; font-stretch: 125%;
        font-size: clamp(4.5rem,11vw,9rem); line-height: .8; color: var(--brick);
        letter-spacing: -.03em; margin: 0 0 -.05em -.04em; display: block; pointer-events: none;
    }
    @media (min-width:880px){ .proj__num { margin-left: -42px; } }
    .proj__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem 1.2rem; margin-bottom: 1.4rem; }
    .proj__title { font-size: clamp(1.8rem,3.4vw,2.6rem); margin: 0; }
    .proj__where { font-family: var(--mono); font-size: .8125rem; text-transform: uppercase; letter-spacing: .1em; color: var(--olive); }

    .proj__bleed { width: 100vw; margin-left: calc(50% - 50vw); border-top: 2px solid var(--teak); border-bottom: 2px solid var(--teak); line-height: 0; }
    .proj__bleed img { width: 100%; height: clamp(260px,44vw,560px); object-fit: cover; display: block; }

    .proj__cols { display: grid; grid-template-columns: 2fr 1fr; gap: clamp(1.5rem,4vw,3rem); align-items: start; margin-top: clamp(1.5rem,3vw,2.2rem); }
    .proj__cols--flip { grid-template-columns: 1fr 2fr; }
    .proj__cols--flip .proj__media { order: 2; }
    .proj__media .render img { aspect-ratio: 4/3; object-fit: cover; }
    .proj__body { color: var(--ink); }
    .proj__body p { margin: 1rem 0 0; }
    .proj__body .spec { margin-bottom: 1.2rem; }

    /* halftone context photo */
    .halftone { position: relative; display: block; line-height: 0; border: 2px solid var(--teak); }
    .halftone::after {
        content: ""; position: absolute; inset: 0; pointer-events: none;
        background-image: radial-gradient(circle, rgba(39,39,31,.5) 22%, transparent 24%);
        background-size: 5px 5px; mix-blend-mode: multiply; opacity: .55;
    }
    .halftone img { display: block; width: 100%; height: clamp(240px,34vw,420px); object-fit: cover; filter: contrast(1.08) saturate(.65); }
    .context { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(1.5rem,4vw,3rem); align-items: center; }

    .placeholder {
        border: 2px dashed var(--ink); padding: clamp(2rem,5vw,3.5rem); text-align: center;
        font-family: var(--mono); text-transform: uppercase; letter-spacing: .12em; color: var(--ink);
    }
    .placeholder strong { display: block; font-family: var(--display); font-stretch: 125%; font-size: clamp(1.4rem,3vw,2rem); letter-spacing: 0; margin-bottom: .5rem; }

    .cta-band { text-align: center; }
    .cta-band .eyebrow { color: #e3e1bd; }
    .cta-band h2 { color: var(--chalk); font-size: clamp(2.2rem,5vw,3.6rem); max-width: 18ch; margin: 0 auto 1.8rem; }

    @media (max-width: 860px) {
        .proj__cols, .proj__cols--flip { grid-template-columns: 1fr; }
        .proj__cols--flip .proj__media { order: 0; }
        .context { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{% block content %}

{# ===== 02 · WORK OPENER ===== #}
<section class="section reveal">
    <div class="wrap">
        <div class="sec-head">
            <span class="numeral" aria-hidden="true">02</span>
            <p class="eyebrow">Portfolio</p>
            <h1>Work</h1>
            <p class="sec-head__lead">The studio's renders, presented as a working portfolio rather than a feed. Each one is drawn in-house, in the same quiet, low-contrast style — the architecture leading, the grid keeping it honest.</p>
        </div>
        <hr class="rule">
    </div>
</section>

{# ===== Future entries the firm adds via /admin appear here ===== #}
{% for e in entries %}
<section class="proj reveal">
    <div class="wrap">
        <span class="proj__num" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
        <div class="proj__head">
            <h2 class="proj__title">{{ e.field('title', 'Untitled project') }}</h2>
            {% if e.field('location') %}<span class="proj__where">{{ e.field('location') }}</span>{% endif %}
        </div>
        <div class="proj__cols">
            <div class="proj__media">
                {% if e.field('image') %}
                <figure class="render"><img src="{{ e.field('image') }}" alt="{{ e.field('image_alt', e.field('title')) }}"></figure>
                {% endif %}
            </div>
            <div class="proj__body">
                <div class="spec">
                    <div class="spec__row"><span class="spec__k">Scope</span><span class="spec__v">{{ e.field('scope', '—') }}</span></div>
                    <div class="spec__row"><span class="spec__k">Location</span><span class="spec__v">{{ e.field('location', '—') }}</span></div>
                    <div class="spec__row"><span class="spec__k">Year</span><span class="spec__v">{{ e.field('year', '—') }}</span></div>
                    <div class="spec__row"><span class="spec__k">Status</span><span class="spec__v">{{ e.field('status', '—') }}</span></div>
                </div>
                {% if e.field('summary') %}<p>{{ e.field('summary') }}</p>{% endif %}
            </div>
        </div>
        <hr class="rule">
    </div>
</section>
{% endfor %}

{# ===== Seed portfolio — the studio's own renders (ref-01, ref-02) ===== #}
<section class="proj reveal">
    <div class="wrap">
        <span class="proj__num" aria-hidden="true">01</span>
        <div class="proj__head">
            <h2 class="proj__title">Hillside Residence</h2>
            <span class="proj__where">Batangas · Residential</span>
        </div>
    </div>
    <figure class="proj__bleed">
        <img src="/uploads/ref-01.png" alt="Tropical-modern hillside residence with pitched roofs, teak louver screens and tinted glazing, three-quarter render">
    </figure>
    <div class="wrap">
        <div class="proj__cols">
            <div class="proj__body">
                <p>A stepped family home that follows the contour of the slope. Pitched roofs throw deep shade across the upper terrace, timber louver screens filter the hard western sun, and sage-tinted glazing opens the living level to the valley. The massing breaks the volume down so a large house still reads as a cluster of smaller, climate-tuned forms.</p>
                <p>Drawn from concept through to the construction-document set a contractor can price and build.</p>
            </div>
            <div class="proj__media">
                <div class="spec">
                    <div class="spec__row"><span class="spec__k">Scope</span><span class="spec__v">Residential design + CD</span></div>
                    <div class="spec__row"><span class="spec__k">Location</span><span class="spec__v">Batangas</span></div>
                    <div class="spec__row"><span class="spec__k">Year</span><span class="spec__v">2022</span></div>
                    <div class="spec__row"><span class="spec__k">Status</span><span class="spec__v">Concept render</span></div>
                </div>
            </div>
        </div>
        <hr class="rule">
    </div>
</section>

<section class="proj reveal">
    <div class="wrap">
        <span class="proj__num" aria-hidden="true">02</span>
        <div class="proj__head">
            <h2 class="proj__title">Garden Pavilion</h2>
            <span class="proj__where">Batangas · Concept study</span>
        </div>
        <div class="proj__cols proj__cols--flip">
            <div class="proj__media">
                <figure class="render">
                    <img src="/uploads/ref-02.png" alt="Conceptual X-ray render of a glass pavilion among bamboo and trees, structure and landscape reading through each other">
                </figure>
            </div>
            <div class="proj__body">
                <div class="spec">
                    <div class="spec__row"><span class="spec__k">Scope</span><span class="spec__v">Concept study</span></div>
                    <div class="spec__row"><span class="spec__k">Location</span><span class="spec__v">Batangas</span></div>
                    <div class="spec__row"><span class="spec__k">Year</span><span class="spec__v">2023</span></div>
                    <div class="spec__row"><span class="spec__k">Status</span><span class="spec__v">In design</span></div>
                </div>
                <p>An X-ray study of a glass pavilion set in a bamboo grove. Rendered semi-transparent so structure and landscape read through each other, the drawing tests how lightly a house can sit in the green — a question of restraint as much as form.</p>
            </div>
        </div>
        <hr class="rule">
    </div>
</section>

{# ===== Context photo — explicitly NOT the firm's work ===== #}
<section class="section reveal">
    <div class="wrap">
        <div class="sec-head">
            <p class="eyebrow">Context</p>
            <h2>The kind of place we build for</h2>
        </div>
        <div class="context">
            <figure class="halftone">
                <img src="/uploads/context-house.jpg" alt="A modern stone-and-white house with arches on a tropical hillside under a bright sky">
            </figure>
            <div>
                <p>Batangas builds for sun, rain, and sea air. Our work answers that climate — stone bases, deep eaves, screened openings, and shaded outdoor rooms.</p>
                <p class="figcap">Context image — tropical residential architecture, Philippines. Not a project by Anyo at Disenyo.</p>
            </div>
        </div>
        <hr class="rule">
    </div>
</section>

{# ===== Placeholder — client to supply more projects ===== #}
<section class="section--tight reveal">
    <div class="wrap">
        <div class="placeholder">
            <strong>More projects — coming soon</strong>
            Add your finished homes and renders from the studio admin.
        </div>
        <hr class="rule">
    </div>
</section>

{# ===== Closing CTA ===== #}
<section class="band band--olive cta-band reveal">
    <div class="wrap">
        <p class="eyebrow">Have a site in mind?</p>
        <h2>Let's put your project on this page</h2>
        <a href="/contact" class="btn btn--light">Request consultation <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
</section>

{% endblock %}
